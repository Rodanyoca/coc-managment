# Modèle sans secrets. Conserver les autres variables de l'installation COC.
# Authentification et feuilles (identité serveur existante)
AUTH_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Classeur USERS, utilisé pour les permissions et la journalisation
GOOGLE_SHEETS_USERS_SPREADSHEET_ID=
# Drive OAuth existant ; ne jamais exposer ces valeurs au navigateur
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Images Site Web : dossier existant réutilisé s'il reste privé.
GOOGLE_DRIVE_SITE_WEB_SLIDERS_FOLDER_ID=
# Facultatif : dossier privé distinct pour les nouvelles images Site Web.
GOOGLE_DRIVE_SITE_WEB_IMAGES_FOLDER_ID=
# Obligatoire pour envoyer des PDF publics : dossier privé dédié au Site Web.
# Ne pas utiliser GOOGLE_DRIVE_DOCUMENTS_FOLDER_ID (documents métier privés).
GOOGLE_DRIVE_SITE_WEB_DOCUMENTS_FOLDER_ID=
# Facultatif : origine HTTPS du SaaS servant les médias contrôlés.
# Défaut du code : https://database.coc-rdc.net ; localhost HTTP permis en dev.
SITE_WEB_MEDIA_BASE_URL=
# Le classeur unique Site Web est déclaré dans lib/site-web/config.ts.
# Aucun ancien classeur Site Web ou Référentiel n'est utilisé pour ses statuts.
